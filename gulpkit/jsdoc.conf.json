{
  "opts": {
    "destination": "./gulpkit/docs",
    "recurse": true,
    "private": true,
    "template": "node_modules/docdash"
  },
  "source": {
    "include": ["./gulpkit"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(node_modules|gulpkit/docs|config/config_preview.js)"
  },
  "docdash": {
    "static" : true,
    "sort": true,
    "lineNumbers": true,
    "sectionOrder" : [ "Modules", "Classes"],
    "collapse" : true
  }
}
